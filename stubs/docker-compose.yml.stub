services:
  MEU_APP:
    build: .
    image: MEU_APP:latest
    container_name: MEU_APP
    ports:
      - "8000:80"
    depends_on:
      - mariadb
    networks:
      - MEU_APP-network
    volumes:
      - ./:/var/www/html
    environment:
      HOME: /tmp
    user: "${UID:-1000}:${GID:-1000}"

  mariadb:
    image: mariadb:11
    container_name: MEU_APP_mariadb
    restart: always
    environment:
      MYSQL_DATABASE: MEU_APP
      MYSQL_USER: MEU_APP
      MYSQL_PASSWORD: MEU_APP
      MYSQL_ROOT_PASSWORD: MEU_APP
    volumes:
      - mariadb_data:/var/lib/mysql
    networks:
      - MEU_APP-network

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: MEU_APP_phpmyadmin
    restart: always
    depends_on:
      - mariadb
    ports:
      - "8081:80"
    environment:
      PMA_HOST: mariadb
      PMA_PORT: 3306
      PMA_USER: root
      PMA_PASSWORD: MEU_APP
    networks:
      - MEU_APP-network

  selenium:
    image: selenium/standalone-chrome
    container_name: MEU_APP_selenium
    ports:
      - "7900:7900"
    networks:
      - MEU_APP-network
    shm_size: 2gb

  # No /etc/hosts do seu computador colocar a linha `127.0.0.1 auth.local` 
  # particularidades do protocolo oAuth1 usado na USP
  senhaunica-faker:
    image: uspdev/senhaunica-faker
    container_name: MEU_APP_senhaunica-faker
    ports:
      - "3141:3141"
    environment:
          - APP_URL=http://auth.local:3141
    networks:
      MEU_APP-network:
        aliases:
          - auth.local

networks:
  MEU_APP-network:

volumes:
  mariadb_data: